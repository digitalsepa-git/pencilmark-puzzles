    },
    "That cell stays white in the solution. Tap it again to clear it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hücre çözümde beyaz kalıyor. Temizlemek için tekrar dokun."
          }
        }
      }
    },
    "That digit breaks a row, a column or its cage. Tap Undo and try again." : {
      "localizations" : {
