    "Your solved puzzles, best times, streaks, unfinished games and settings are stored on this device only. Deleting the app deletes them." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your solved puzzles, best times, streaks, unfinished games and settings are stored on this device only. Deleting the app deletes them."
