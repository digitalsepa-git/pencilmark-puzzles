          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly and yearly plans renew automatically unless cancelled at least 24 hours before the period ends. Manage or cancel in your Apple Account settings. The lifetime plan is a single purchase."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aylık ve yıllık planlar, dönem bitmeden en az 24 saat önce iptal edilmezse kendiliğinden yenilenir. Apple Hesabı ayarlarınızdan yönetebilir ya da iptal edebilirsiniz. Ömür boyu plan tek seferlik bir satın almadır."
          }
        }
      }
    },
